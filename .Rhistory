# Age mean (sd)
age_mean <- mean(df2$age, na.rm=TRUE)
age_sd   <- sd(df2$age, na.rm=TRUE)
# Total cholesterol median (IQR)
tc_median <- median(df2$total_chol, na.rm=TRUE)
tc_q1 <- quantile(df2$total_chol, 0.25, na.rm=TRUE)
tc_q3 <- quantile(df2$total_chol, 0.75, na.rm=TRUE)
# Categorical counts and percent
tab_gender <- df2 %>% count(gender) %>% mutate(pct = n/sum(n)*100)
tab_smoking <- df2 %>% count(smoking) %>% mutate(pct = n/sum(n)*100)
tab_hyper <- df2 %>% count(hyperchol) %>% mutate(pct = n/sum(n)*100)
# Print
cat(sprintf("Age mean (sd): %.2f (%.2f)\n", age_mean, age_sd))
cat(sprintf("Total Cholesterol median (IQR): %.1f (%.1f - %.1f)\n", tc_median, tc_q1, tc_q3))
print(tab_gender); print(tab_smoking); print(tab_hyper)
