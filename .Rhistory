df2 <- df %>%
  mutate(
    age = as.numeric(age),
    total_chol = as.numeric(total_chol),
    ldl = as.numeric(ldl),
    gender = case_when(
      tolower(as.character(gender)) %in% c("m","male","1") ~ "Male",
      tolower(as.character(gender)) %in% c("f","female","2") ~ "Female",
      TRUE ~ as.character(gender)
    ),
    smoking = ifelse(tolower(as.character(smoking)) %in% c("1","yes","y","true"), "Yes", "No"),
    hyperchol = ifelse(tolower(as.character(hyperchol)) %in% c("1","yes"), "Yes", "No"),
    diabetes = ifelse(tolower(as.character(diabetes)) %in% c("1","yes"), "Yes", "No")
  )
