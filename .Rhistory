#test association smoking × diabetes (chi-square, OR via logistic)
# Contingency table
tab <- table(df2$smoker, df2$diabetes)
print(tab)
chisq.test(tab)          # Chi-sq (if expected counts OK)
fisher.test(tab)         # Fisher's exact if small counts
# If 2x2, compute OR and 95% CI using epiR
if (all(dim(tab)==c(2,2))) {
  or_res <- epi.2by2(tab, method="cohort.count", conf.level=0.95)
  print(or_res)
}
# Logistic regression for adjusted OR (if want covariates)
df2$diab_bin <- ifelse(df2$diabetes=="Yes", 1, 0)
df2$smoke_bin <- ifelse(df2$smoker=="Yes", 1, 0)
mod <- glm(diab_bin ~ smoke_bin, data=df2, family=binomial)
summary(mod)
exp(cbind(OR = coef(mod), confint(mod)))
