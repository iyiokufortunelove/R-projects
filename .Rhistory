diabetes prevalence by 
#diabetes prevalence by gender
prev_gender <- df2 %>%
  filter(!is.na(gender) & !is.na(diabetes)) %>%
  group_by(gender) %>%
  summarise(n_diabetes = sum(diabetes=="Yes"),
            n_total = n(),
            prevalence = n_diabetes/n_total*100)
print(prev_gender)
